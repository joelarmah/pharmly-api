ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://pharmly:pharmly@localhost:5432/pharmly
JWT_SECRET=change-me-to-a-random-32-byte-value

# SMS_PROVIDER=console logs OTP codes instead of sending them (default, dev-safe).
# Set to "arkesel" to send via Arkesel; ARKESEL_API_KEY is then required.
SMS_PROVIDER=console
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Pharmly
# Leave unset to auto-sandbox everywhere except ENVIRONMENT=prod.
# ARKESEL_SANDBOX=true
